# Backend environment (optional). Export these before running the server, or use a process manager that loads them.

# Ollama runs on localhost alongside the backend (default 127.0.0.1:11434).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# On the machine where you run "ollama serve", set a higher context if you see truncation/context errors:
#   OLLAMA_CONTEXT_LENGTH=16384 ollama serve   (or export OLLAMA_CONTEXT_LENGTH=16384)

# Models (must be pulled in Ollama: ollama pull <model>). Name must match ollama list exactly.
LLM_MODEL=qwen3:1.7b
# Used when "Fast Response" is selected in the Chat pane (vector search + LLM only; default qwen3:4b).
FAST_RESPONSE_MODEL=qwen3:1.7b
# Lightweight model for KB (entity classification, disambiguation). Keeps heavy LLM for chat/generation.
INTERNAL_REASONING_AGENT=qwen3:1.7b
# VL embedding (text + images). Use qwen3-embedding:8b for text-only.
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Vision model for screenshot UI description (and optional PDF/visual). Requires Ollama 0.12.7+ for qwen3-vl.
# If you see "0 chars" / empty description, check backend logs for "VLM empty content diagnostic" and try another model (e.g. llava).
VLM_MODEL=qwen2.5vl:3b
# When true (default), use PageIndex reasoning-based retrieval + VLM with retrieved PDF page images for answer generation.
# USE_VLM_VISUAL_ANSWER=true

# PDFs with very little selectable text per page (image-heavy, unselectable): run full VLM extraction at ingestion so context is persisted. Default 200 chars/page.
# VLM_MIN_CHARS_PER_PAGE=200

# PDF triage: per-page text/image heuristics route to fast_pageindex | ocr_scanned | mixed_layout | complex_visual.
# PDF_TRIAGE_ENABLED=true
# PDF_TRIAGE_TEXT_HEAVY_CHARS=50
# PDF_TRIAGE_IMAGE_HEAVY_CHAR_MAX=50

# Fast OCR for scanned text (not the heavy VLM). Tesseract binary must be installed on the system; OCR_MODEL is used when Tesseract is unavailable or for complex layouts.
# OCR_MODEL=qwen3-vl:2b

# Reranker (second-pass relevance). On by default. Requires Ollama with /api/rerank.
RERANKER_ENABLED=false
# RERANKER_CANDIDATES=20

# PageIndex (official-style summaries and page ranges)
# PAGEINDEX_SUMMARY_MAX_TOKENS=250
# Use legacy PDF parser for correct start_index/end_index: PAGEINDEX_USE_LEGACY_PDF=true

# Import folder: segment names that start the "target" path for tags/path_hierarchy (e.g. vessel names).
# First matching segment in the full path onward is used. Comma-separated; default list if unset.
# IMPORT_TAG_ANCHOR_SEGMENTS=Trader,Transporter,Pusher,Swift,Reliant,DukePoint,SwartzBay,Surrey,Tilbury

# When set to a positive number (e.g. 500), the UI suggests "Run without Graph" for documents
# with page_count >= this value (useful for very long textbooks where Graph RAG takes days).
# GRAPH_SKIP_PAGE_THRESHOLD=500

# Graph RAG ingestion (extraction + community summaries) uses, in order: EXTRACTION_MODEL if set,
# else FAST_RESPONSE_MODEL, else LLM_MODEL. So with defaults, graph uses FAST_RESPONSE_MODEL for performance.
# Override with EXTRACTION_MODEL to use a different model for graph only.
# EXTRACTION_MODEL=

# Regulatory knowledge base (EDI, WCAG, HIPAA): documents with these tags or filename substrings
# are forced into the Graph RAG pipeline at ingestion. Comma-separated.
# REGULATORY_TAGS=regulatory,WCAG,HIPAA,accessibility,EDI
# REGULATORY_FILENAME_PATTERNS=wcag,hipaa,accessibility,cfr,ocr
# When true, regulatory docs run only the graph pipeline (no PageIndex/contextual).
# REGULATORY_GRAPH_ONLY=false
